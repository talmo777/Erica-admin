# 이 파일을 복사해 .env.local 로 만들고 실제 값을 채우세요.
# (.env.local 은 .gitignore 대상 — 키를 커밋/공유하지 마세요)

# Supabase (대시보드 → Project Settings → API)
VITE_SUPABASE_URL=https://<your-project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=<your-supabase-anon-key>

# 외부 Board-API 주소 (공모전 CRUD·AI추출·승인체크). 없으면 비워둠.
VITE_BOARD_API_BASE_URL=

# 수집 인박스가 호출할 로컬 크롤러 서버 (crawler/: npm run serve)
VITE_CRAWLER_API_BASE=http://localhost:8787
